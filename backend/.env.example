# Copy to backend/.env and fill in. This file is the ONLY place the OpenAI key goes.
# Never prefix it NEXT_PUBLIC_, never send it to the browser, never commit backend/.env.

# development | production | test
APP_ENV=development

# auto   = OpenAI when OPENAI_API_KEY below is set, Demo AI when it's blank (recommended)
# fake   = always Demo AI: canned replies, and your key is NOT used even if it's set
# openai = always OpenAI (AI features are off if the key is blank)
# After changing this file, restart the backend: it doesn't reload .env on its own.
AI_MODE=auto

# Your key, starting sk-. Server only. With AI_MODE=auto, setting it switches the app to OpenAI.
OPENAI_API_KEY=
# Or https://eu.api.openai.com/v1 once OpenAI approves Europe-region processing
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_VISION=gpt-6.1-sol
OPENAI_MODEL_TEXT=gpt-6-luna
OPENAI_MODEL_DECISIONS=gpt-6-luna
OPENAI_MODEL_EMBEDDINGS=text-embedding-3-small
OPENAI_MODEL_MODERATION=omni-moderation-latest
# Phase 6 (not used in v1-base)
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
OPENAI_MODEL_TTS=gpt-4o-mini-tts
OPENAI_MODEL_IMAGE=gpt-image-2.5-flare

# Hashes user IDs for OpenAI's safety_identifier. Any long random string, e.g. from: openssl rand -hex 32
SAFETY_ID_SALT=change-me
# Database. The default is a SQLite file at backend/var/crown.db: built into Python, nothing to install.
# For Postgres with pgvector (production, or locally if you have it), use instead:
#   DATABASE_URL=postgresql+psycopg://crown:crown@localhost:5432/crown
DATABASE_URL=sqlite:///var/crown.db
# Only "local" exists in v1-base (files in backend/var/photos). Production needs private UK object storage.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=eu-west-2
# Signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:3000

# Limits. Leave the monthly cap blank until the Phase 3 cost check.
AI_MONTHLY_CAP_PER_USER=
AI_RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=12

# Development only: let the Coach cite library articles still marked "draft".
# Must be false for real users (the server refuses to start in production otherwise).
LIBRARY_INCLUDE_DRAFTS=true
# Minimum similarity for a library passage to count as an answer. Tune with the eval set.
COACH_MIN_SIMILARITY=0.30
