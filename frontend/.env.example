# Copy to .env.local. Nothing here is secret: the OpenAI key lives only in backend/.env.

# Where FastAPI listens. Read by next.config.ts rewrites, server side only.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Crown AI

# Phase 6 web push (not used in v1-base)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
